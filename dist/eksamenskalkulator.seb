<?xml version="1.0" encoding="utf-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>originatorVersion</key>
    <string>SEB_Config_Matteeksamen_2027_Udir_Demo</string>
    <key>startURL</key>
    <string>https://voxcuriosa.no/kalkulator/</string>
    <key>allowQuit</key>
    <true/>
    <key>quitURL</key>
    <string></string>
    <key>browserViewMode</key>
    <integer>0</integer>
    <key>mainBrowserWindowWidth</key>
    <string>1024</string>
    <key>mainBrowserWindowHeight</key>
    <string>768</string>
    <key>mainBrowserWindowPositioning</key>
    <integer>1</integer>
    <key>enableBrowserWindowToolbar</key>
    <false/>
    <key>hideBrowserWindowToolbar</key>
    <true/>
    <key>showReloadButton</key>
    <true/>
    <key>showReloadWarning</key>
    <false/>
    <key>allowSpellCheck</key>
    <false/>
    <key>allowDictionaryLookup</key>
    <false/>
    <key>allowDeveloperConsole</key>
    <false/>
    <key>allowFlashFullscreen</key>
    <false/>
    <key>sendBrowserExamKey</key>
    <false/>
    <key>URLFilterEnable</key>
    <true/>
    <key>URLFilterEnableContentFilter</key>
    <true/>
    <key>URLFilterRules</key>
    <array>
        <dict>
            <key>action</key>
            <integer>1</integer>
            <key>active</key>
            <true/>
            <key>regex</key>
            <false/>
            <key>expression</key>
            <string>https://voxcuriosa.no/kalkulator/*</string>
        </dict>
    </array>
    <key>blockPopUpWindows</key>
    <true/>
    <key>newBrowserWindowByLinkPolicy</key>
    <integer>0</integer>
    <key>allowDownUploads</key>
    <false/>
    <key>allowDownloads</key>
    <false/>
    <key>allowUploads</key>
    <false/>
    <key>enableAppSwitching</key>
    <false/>
    <key>enableAltTab</key>
    <false/>
    <key>enablePrintScreen</key>
    <false/>
    <key>enableF1</key>
    <false/>
    <key>enableF2</key>
    <false/>
    <key>enableF3</key>
    <false/>
    <key>enableF4</key>
    <false/>
    <key>enableF5</key>
    <true/>
    <key>enableF12</key>
    <false/>
    <key>hookKeys</key>
    <true/>
    <key>clipboardPolicy</key>
    <integer>0</integer>
</dict>
</plist>
